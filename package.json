{
  "name": "nexus-insights",
  "version": "1.0.2",
  "description": "Personal LoL data analysis tool",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "node --test \"test/*.test.js\"",
    "parity": "node scripts/parity-check.js",
    "diagnose": "node scripts/diagnose-sync.js",
    "cleanup": "node scripts/cleanup-matches.js",
    "coaching": "node scripts/coaching-report.js",
    "dist": "node scripts/build-installer.js",
    "release": "node scripts/build-installer.js --publish"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "electron-updater": "^6.8.9",
    "sqlite3": "^5.0.2"
  },
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nexusinsights.app",
    "productName": "Nexus Insights",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus Insights",
      "include": "installer/installer.nsh",
      "artifactName": "Nexus-Insights-Setup.${ext}"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "electronDist": "node_modules/electron/dist",
    "publish": [
      {
        "provider": "github",
        "owner": "toancina",
        "repo": "nexus-insights",
        "releaseType": "release"
      }
    ]
  },
  "author": "Nexus Insights",
  "license": "UNLICENSED"
}
