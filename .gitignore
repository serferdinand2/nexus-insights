# ── Secrets ──────────────────────────────────────────────
# NOTE: the app does NOT read .env. The Riot API key lives in
# %APPDATA%\nexus-insights\config.json and is set via the in-app
# Settings dialog. These rules are belt-and-braces only.
.env
.env.*
!.env.example

# ── Dependencies ─────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────
dist/
out/
build/
*.asar

# ── Local database (personal match data, hundreds of MB) ─
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.backup.sqlite

# ── Logs / diagnostics ───────────────────────────────────
*.log
npm-debug.log*
logs/

# ── Editor / OS cruft ────────────────────────────────────
.claude/settings.local.json
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
